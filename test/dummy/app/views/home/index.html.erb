<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio Users",
    subtitle: "A dummy host for immutable user profiles and Recording Studio history.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Foundation",
          subtitle: "The engine-owned data model.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Each host user can own one UUID-backed user root.</li>
          <li>Profile edits create immutable snapshots through Recording Studio.</li>
          <li>Read helpers never provision records as a side effect.</li>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Safe integrations",
          subtitle: "Optional behavior stays explicit and fail-closed.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Self-service policy is separate from lookup and presentation.</li>
          <li>Cross-user search requires a host policy decision.</li>
          <li>No access grants, attachments, routes, or admin screens are installed automatically.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
